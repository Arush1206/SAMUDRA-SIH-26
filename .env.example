# ── FastAPI ───────────────────────────────────────────────────────────────────
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# ── Data Paths ────────────────────────────────────────────────────────────────
AIS_DATA_DIR=backend/data/sample_ais
SAR_DATA_DIR=backend/data/sample_sar
CANONICAL_JSON_PATH=backend/data/canonical_example.json

# ── DuckDB ────────────────────────────────────────────────────────────────────
DUCKDB_IN_MEMORY=true
DUCKDB_FILE_PATH=backend/data/samudra.duckdb
